# ============================================================
# NFCY environment
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Database (required) ---
# Local development: `npm run pg:start` prints this exact value.
# Production: a managed Postgres, for example Neon or Supabase.
DATABASE_URL="postgresql://contap:contap_dev@127.0.0.1:5433/contap"

# --- App (required) ---
# The public origin. Used for profile links, QR codes, NFC redirects and og tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs sessions, activation codes and the daily visitor salt.
AUTH_SECRET=""

# --- Razorpay (required before real payments) ---
# Test keys work with no KYC: dashboard.razorpay.com -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret you choose when adding the webhook in the Razorpay dashboard.
# Webhook URL: https://your-domain/api/payment/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Email (optional; without it, notifications queue in the database and are
#     visible in the admin panel instead of being sent) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="NFCY <hello@example.com>"

# --- Image storage ---
# "db"  keeps uploads in Postgres. Works everywhere with no account. The default.
# "s3"  uses any S3 compatible bucket. Fill the four values below.
STORAGE_DRIVER="db"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- First admin, created by the seed ---
SEED_ADMIN_EMAIL="admin@nfcy.in"
SEED_ADMIN_PASSWORD="ChangeThisNow!2026"
SEED_ADMIN_NAME="NFCY Admin"

# --- Business contact shown on the site ---
NEXT_PUBLIC_WHATSAPP="918141337021"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@nfcy.in"

# --- Cron protection (Vercel Cron sends this) ---
CRON_SECRET=""
