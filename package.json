{
  "name": "contap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "pg:start": "tsx scripts/devdb.ts start",
    "pg:stop": "tsx scripts/devdb.ts stop",
    "test": "tsx tests/run.ts && tsx tests/commerce.ts && tsx tests/pages.ts",
    "test:profile": "tsx tests/run.ts",
    "test:commerce": "tsx tests/commerce.ts",
    "test:pages": "tsx tests/pages.ts",
    "build:local": "prisma generate && next build",
    "db:which": "node scripts/which-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "next": "^15.1.3",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "embedded-postgres": "^17.2.0-beta.15",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
